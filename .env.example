PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/traveltracker
JWT_SECRET=traveltracker-pwa-secret-jwt-key-2026

# Configuration Google OAuth (Sign in with Google)
# Obtenez votre Client ID depuis la console Google Cloud : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Configuration SMTP pour envoi réel des e-mails OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Travel Tracker PWA" <votre-email@gmail.com>
